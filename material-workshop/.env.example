# 本地素材制作配置。复制为 .env 后填写，不提交 Git，不部署进容器。
TOKENHUB_API_KEY=
TOKENHUB_BASE_URL=https://tokenhub.tencentmaas.com/v1
MUSIC_MODEL=minimax-music-v2.6

# 腾讯云 TTS 使用云 API 凭据，不是 TokenHub 的 API Key。
TENCENTCLOUD_SECRET_ID=
TENCENTCLOUD_SECRET_KEY=
TTS_VOICE_TYPE=101001
TTS_SPEED=-1
TTS_SAMPLE_RATE=16000
TTS_ENABLE_SUBTITLE=true
