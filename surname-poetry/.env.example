# 复制为 .env。只在本机或服务器填写密钥，不提交 Git。
APP_PORT=8080
TOKENHUB_API_KEY=
TOKENHUB_BASE_URL=https://tokenhub.tencentmaas.com/v1
VISION_MODEL=hy-vision-2.0-instruct
# 生产环境必填，至少八位。老师打开课堂后，孩子无需再输入口令。
# 本地可运行 npm run setup 生成随机口令，保存到 .env。
CLASSROOM_ACCESS_CODE=
# 使用 HTTPS 访问且反向代理已配置后改成 true。
SECURE_COOKIES=false
# 单个进程每天最多发出的模型调用数；重启会清零，不是腾讯云账单硬限额。
RECOGNITION_DAILY_LIMIT=300
